{
  "name": "my-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview:cloudflare": "wrangler dev .output/server/index.mjs --assets .output/public",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "wrangler": "4.130.0"
  }
}
